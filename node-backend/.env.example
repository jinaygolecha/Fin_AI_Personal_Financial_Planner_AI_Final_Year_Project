# ====================================================================
# FINPRO — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: FinPro — Personal Finance & Investment Decision Support Platform
# Branding: Created by Students of VU
# Project Lead: Jinay Golecha
# ====================================================================
# Copy this file to .env and configure your values.
# NEVER commit real credentials, passwords, or API keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:5000

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# PostgreSQL via Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# --------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/finance_jinay"

# --------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED)
# --------------------------------------------------------------------
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (OPTIONAL)
# If unconfigured, the app provides a graceful notice and uses email/password auth.
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:5000/api/v1/auth/google/callback

# --------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE — GOOGLE GEMINI (OPTIONAL)
# If unconfigured, the backend uses deterministic rule-based advisory grounded in user data.
# --------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 6. MARKET DATA APIS (OPTIONAL)
# Real-time and historical quotes for NSE/BSE, COMEX Gold/Silver, FX.
# --------------------------------------------------------------------
MARKET_DATA_API_KEY=YOUR_MARKET_DATA_API_KEY
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# --------------------------------------------------------------------
# 7. FINANCIAL NEWS — MARKETAUX API (OPTIONAL)
# Real-time financial headlines and market sentiment.
# --------------------------------------------------------------------
MARKETAUX_API_KEY=YOUR_MARKETAUX_API_KEY

# --------------------------------------------------------------------
# 8. OCR RECEIPT SCANNER (OPTIONAL)
# Tesseract OCR operates locally; external OCR API keys if configured.
# --------------------------------------------------------------------
OCR_API_KEY=YOUR_OCR_API_KEY

# --------------------------------------------------------------------
# 9. LOCALIZATION & SYSTEM SETTINGS
# --------------------------------------------------------------------
CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata
