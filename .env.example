# ====================================================================
# JINAY FINANCE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: AI-Powered Personal Finance & Investment Advisor
# Owner: Jinay Golecha
# ====================================================================
# Copy this file to .env (or node-backend/.env) and configure values.
# NEVER commit real credentials, passwords, or API keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:5000

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# --------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/finance_jinay"

# --------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED)
# Generate cryptographically secure random secrets for production.
# --------------------------------------------------------------------
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (OPTIONAL)
# If unconfigured, the app provides a graceful notice and uses email/password auth.
# Obtain from: https://console.cloud.google.com/apis/credentials
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/google/callback

# --------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE — GOOGLE GEMINI (OPTIONAL)
# If unconfigured, the app falls back to built-in rule-based financial advisory.
# Obtain from: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 6. MARKET DATA — FINNHUB STOCK & METALS API (OPTIONAL)
# If unconfigured, the app uses real baseline reference prices with DELAYED labels.
# Obtain from: https://finnhub.io/
# --------------------------------------------------------------------
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# --------------------------------------------------------------------
# 7. LOCALIZATION & SYSTEM SETTINGS
# --------------------------------------------------------------------
CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata
PROJECT_OWNER="Jinay Golecha"
