# ========================================
# Jinay Finance AI — Node.js Backend
# Owner: Jinay Golecha
# COPY THIS FILE TO .env AND FILL IN VALUES
# ========================================

NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/finance_jinay"

JWT_SECRET=your_strong_jwt_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/google/callback

GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash

FINNHUB_API_KEY=your_finnhub_api_key

FRONTEND_URL=http://127.0.0.1:3000

CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata
PROJECT_OWNER=Jinay Golecha
